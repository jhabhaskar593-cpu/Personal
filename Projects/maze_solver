bool path_finder (int x, int y, char destination, char maze[][COLS])
{
    //1. If out of bounds → stop
    if (x >= 20 || x < 0 || y >= 20 || y < 0)
    {
        return false;
    }
//2. If wall → stop
    if(maze[x][y] == '#')
    {
        return false;
    }
//3. If visited → stop
    if (maze[x][y] == '.')
    {
        return false;
    }
    if (maze[x][y] == destination)
    {
        return true;
    }
//4. mark visited
    char temp = maze[x][y];
    maze[x][y] = '.';
//5. if destination → success

//6. try all 4 directions
    int dx[4] = {0, 0, 1, -1};
    int dy[4] = {-1, 1, 0, 0};
    for (int i = 0; i < 4; i++)
    {
        int nx = x + dx[i];
        int ny = y + dy[i];
        if (path_finder(nx, ny, destination, maze))
        {
            maze[x][y] = '*';
            return true;
        }
    }
  // if any returns true → success

//7. if success:
     // mark this cell '*'
      //return true
      maze[x][y] = temp;
      return false;
//8. else return false
}
